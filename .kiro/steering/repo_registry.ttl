@prefix repo: <https://ontology.example.org/repo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <https://ontology.example.org/local-repos/> .

<registry>
  a repo:RepositoryRegistry ;
  rdfs:label "Local Development Repositories Registry" ;
  repo:rootPath "/Volumes/lemon/cursor" ;
  repo:lastUpdated "2025-11-15T00:00:00Z"^^xsd:dateTime .

# Non-repo folder landmarks (for classification)
<folder/fort>
  a repo:Folder ;
  rdfs:label "fort (local folder)" ;
  repo:localPath "/Volumes/lemon/cursor/fort" .

# Repositories discovered under /Volumes/lemon/cursor
<repo/OpenFlow-Playground>
  a repo:Repository ;
  rdfs:label "OpenFlow-Playground" ;
  repo:localPath "/Volumes/lemon/cursor/OpenFlow-Playground" ;
  repo:originUrl "https://github.com/louspringer/OpenFlow-Playground.git" ;
  repo:tags "playground" .

